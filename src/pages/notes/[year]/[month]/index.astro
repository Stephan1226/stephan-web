---
import ArchiveBrowser from '../../../../components/ArchiveBrowser.astro';
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import { notesRepository } from '../../../../lib/notes';

export async function getStaticPaths() {
	const archive = await notesRepository.getArchive();
	return archive.flatMap(({ year, months }) =>
		months.map(({ month }) => ({
			params: { year: String(year), month: String(month) },
		})),
	);
}

const activeYear = Number(Astro.params.year);
const activeMonth = Number(Astro.params.month);
const archive = await notesRepository.getArchive();
const notes = await notesRepository.listNotesByMonth(activeYear, activeMonth);
---

<BaseLayout
	title={`Notes ${activeYear}. ${activeMonth} — Stephan Kim`}
	description={`${activeYear}년 ${activeMonth}월에 남긴 글 모음.`}
>
	<section class="archive" aria-labelledby="notes-title">
		<header class="archive-header">
			<p class="eyebrow">Archive</p>
			<h1 id="notes-title">Notes</h1>
			<p class="archive-intro">{activeYear}년 {activeMonth}월에 남긴 글 {notes.length}편.</p>
		</header>
		<ArchiveBrowser {archive} {activeYear} {activeMonth} {notes} />
	</section>
</BaseLayout>
